{
  "include_patterns": ["**/*"],
  "exclude_patterns": [],
  "max_file_size_kb": 500,
  "chunk_max_lines": 150,
  "chunk_min_lines": 10,
  "output_dir": ".better-context",
  "manifest_file": "manifest.json",
  "generate_agents_md": true,
  "pagerank_damping": 0.85,
  "pagerank_iterations": 20,
  "language_overrides": {
    ".h": "c"
  }
}
